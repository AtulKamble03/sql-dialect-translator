{
  "sqlserver": {
    "keywords": [
      "TOP", "GETDATE", "GETUTCDATE", "ISNULL", "NVARCHAR", "NCHAR", "NTEXT",
      "IDENTITY", "NOLOCK", "ROWLOCK", "UPDLOCK", "TABLOCK",
      "DATETIME2", "SMALLDATETIME", "UNIQUEIDENTIFIER",
      "PRINT", "RAISERROR", "THROW",
      "TRY", "CATCH", "XACT_ABORT",
      "MERGE", "OUTPUT", "INSERTED", "DELETED",
      "EXEC", "EXECUTE", "SP_", "XP_",
      "CLUSTERED", "NONCLUSTERED",
      "WITH (", "OPTION (", "MAXDOP",
      "CROSS APPLY", "OUTER APPLY",
      "IIF", "CHOOSE",
      "DATEPART", "DATENAME", "DATEDIFF", "DATEADD",
      "STUFF", "CHARINDEX", "PATINDEX",
      "@@ROWCOUNT", "@@IDENTITY", "@@ERROR",
      "SCOPE_IDENTITY", "IDENT_CURRENT"
    ],
    "patterns": [
      "\\[\\w[\\w\\s]*\\]",
      "#\\w+",
      "##\\w+",
      "GO\\s*$",
      "--\\s*nolock"
    ]
  },
  "postgresql": {
    "keywords": [
      "LIMIT", "OFFSET",
      "NOW", "CURRENT_TIMESTAMP", "CURRENT_DATE", "CURRENT_TIME",
      "COALESCE", "NULLIF",
      "SERIAL", "BIGSERIAL", "SMALLSERIAL",
      "BOOLEAN", "BOOL", "TRUE", "FALSE",
      "JSONB", "JSON", "ARRAY", "HSTORE", "UUID",
      "TEXT", "BYTEA", "CIDR", "INET",
      "RETURNING",
      "ON CONFLICT", "DO NOTHING", "DO UPDATE",
      "GENERATE_SERIES", "UNNEST",
      "STRING_AGG", "ARRAY_AGG",
      "EXTRACT", "DATE_TRUNC", "DATE_PART",
      "ILIKE", "SIMILAR TO",
      "RAISE NOTICE", "RAISE EXCEPTION",
      "LANGUAGE plpgsql", "LANGUAGE sql",
      "$$",
      "BEGIN", "EXCEPTION", "END",
      "CREATE OR REPLACE FUNCTION",
      "RETURNS TABLE", "RETURNS SETOF",
      "GENERATED ALWAYS AS IDENTITY",
      "GENERATED BY DEFAULT AS IDENTITY"
    ],
    "patterns": [
      "::[A-Z]+",
      "\\$\\d+",
      "\\$\\$[\\s\\S]*?\\$\\$"
    ]
  }
}
